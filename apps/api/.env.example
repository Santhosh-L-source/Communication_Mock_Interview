# Copy to apps/api/.env and fill in. Never commit the real .env file.

PORT=4001
# Where the web app runs (comma-separated list allowed)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Public address of this API (used in signed download links)
PUBLIC_API_URL=http://localhost:4001

# ---- Supabase (Project Settings > API, and Connect > Session pooler) ----
# Use the SESSION pooler string (port 5432), not the transaction pooler (6543): pg-boss needs sessions.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. This key bypasses row level security; never put it in the web app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Leave empty to verify logins with the project's public JWKS (recommended for new projects).
SUPABASE_JWT_SECRET=

# ---- Storage ----
# supabase = private Supabase Storage buckets (normal). local = files on disk (development and tests only).
STORAGE_DRIVER=supabase
LOCAL_STORAGE_DIR=.local-storage
LOCAL_SIGNING_SECRET=change-me-to-a-long-random-string

# ---- Free AI providers (tried in this order: Gemini, Groq, Ollama) ----
# true = no AI calls at all; scores come from simple built-in rules. Good for a first run.
AI_MOCK=false
# https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# https://console.groq.com/keys (free tier; also used for Whisper speech-to-text)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Optional self-hosted fallback, e.g. http://lab-pc:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:7b
# Optional faster-whisper server with an OpenAI-compatible API
LOCAL_WHISPER_URL=

# ---- Anti-cheat and retention ----
# End the interview after this many high-severity events (0 = never end early)
TERMINATE_AFTER_HIGH_EVENTS=3
EVIDENCE_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=180
# Set false on extra API instances so only one runs background jobs
RUN_JOBS=true
